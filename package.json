{
  "name": "keyflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["server", "providers"],
  "engines": { "node": ">=22" },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w server",
    "db:reset": "npm run db:reset -w server",
    "dev:api": "npm run dev -w server",
    "dev:providers": "npm run dev -w providers",
    "dev:web": "npm run dev -w web",
    "test:races": "npm run test:races -w server"
  }
}
