# --- API ---
PORT=3000
DATABASE_URL=postgres://keyflow:keyflow@localhost:5433/keyflow
ADMIN_TOKEN=dev-admin-token

# --- поставщики выдачи ---
PROVIDERS_URL=http://localhost:4001
PROVIDER_TIMEOUT_MS=3000
PROVIDER_RETRIES=2

# --- воркер ---
WORKER_ENABLED=true
PAYMENTS_POLL_MS=200
DELIVERY_POLL_MS=200
MAX_DELIVERY_ATTEMPTS=5
RETRY_DELIVERY_FAILED_MS=15000
RETRY_OUT_OF_STOCK_MS=30000

# --- заглушки поставщиков (отдельный процесс) ---
PROVIDERS_PORT=4001
